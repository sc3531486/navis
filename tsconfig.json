{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@extensions/*": ["extensions/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "extensions/**/ExtensionUI/src/**/*.ts",
    "extensions/**/ExtensionUI/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src-tauri"
  ]
}