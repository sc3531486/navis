{
  "id": "navis-demo",
  "name": "Navis Demo Extension",
  "version": "1.0.0",
  "displayName": "Navis Demo",
  "publisher": "navis",
  "description": "通用运行时外壳验证插件：演示清单驱动插槽、命令、工具、管线钩子与 stdio JSON-RPC 后端进程。",
  "main": "./ExtensionBackend/main.mjs",
  "ui": "./ExtensionUI/src/index.tsx",
  "permissions": {
    "fs.read": true,
    "network": true
  },
  "contributes": {
    "slots": [
      { "id": "navis-demo.banner", "target": "root", "component": "DemoBanner", "priority": 90 }
    ],
    "providesSlots": [
      "navis-demo.controls"
    ],
    "commands": [
      { "id": "demo.ping", "title": "Demo Ping Backend" },
      { "id": "demo.stream", "title": "Demo Stream" }
    ],
    "tools": [
      {
        "name": "echo",
        "description": "Echo text back from backend process",
        "parameters": {
          "type": "object",
          "properties": { "text": { "type": "string" } }
        }
      },
      {
        "name": "add",
        "description": "Add two numbers in backend process",
        "parameters": {
          "type": "object",
          "properties": { "a": { "type": "number" }, "b": { "type": "number" } }
        }
      }
    ],
    "pipelineHooks": [
      { "hook": "beforeToolExecute", "handler": "toolGuard" }
    ]
  }
}