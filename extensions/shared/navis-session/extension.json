{
  "id": "navis-session",
  "name": "Navis Session",
  "version": "0.1.0",
  "displayName": "Session",
  "publisher": "navis",
  "description": "会话管理扩展（骨架）：会话列表、历史、快照与工作树绑定。",
  "permissions": {
    "fs.read": true,
    "fs.write": true
  },
  "contributes": {
    "slots": [
      { "id": "navis-session.list", "target": "navis-code.sidebar.left", "component": "SessionList", "priority": 25 }
    ],
    "providesSlots": [
      "navis-session.list"
    ],
    "tools": [
      { "name": "session.create", "description": "创建新会话", "parameters": { "type": "object" } },
      { "name": "session.load", "description": "加载会话", "parameters": { "type": "object" } }
    ]
  }
}