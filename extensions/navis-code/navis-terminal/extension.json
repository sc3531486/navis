{
  "id": "navis-terminal",
  "name": "Navis Terminal",
  "version": "0.1.0",
  "displayName": "Terminal",
  "publisher": "navis",
  "description": "终端扩展：PTY 终端、Shell 执行与命令历史。",
  "permissions": {
    "shell.exec": true
  },
  "contributes": {
    "slots": [
      { "id": "navis-terminal.panel", "target": "navis-code.viewport.terminal", "component": "TerminalPanel", "priority": 10 }
    ],
    "providesSlots": [
      "navis-terminal.panel"
    ],
    "tools": [
      { "name": "terminal.exec", "description": "执行 Shell 命令", "parameters": { "type": "object" } }
    ]
  }
}