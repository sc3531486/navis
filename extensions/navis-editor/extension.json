{
  "version": "0.1.0",
  "contributes": {
    "views": [
      {
        "zone": "rightWorkspace",
        "entry": "ExtensionUI/index.html",
        "activation_events": [],
        "name": "Navis Editor",
        "config": {},
        "renderer": "html:sandbox",
        "id": "editor-shell"
      }
    ],
    "capabilities": {
      "provides": [
        "navis-editor"
      ],
      "invoke": [
        "extensions.query",
        "runtime.operation.list",
        "storage.get",
        "storage.set"
      ]
    },
    "editor_languages": [
      {
        "id": "rust",
        "name": "Rust",
        "extensions": [".rs"],
        "lsp_server": "rust-analyzer",
        "features": ["syntax", "completion", "hover", "diagnostics"]
      },
      {
        "id": "typescript",
        "name": "TypeScript",
        "extensions": [".ts", ".tsx"],
        "lsp_server": "typescript-language-server",
        "features": ["syntax", "completion", "hover", "diagnostics"]
      },
      {
        "id": "javascript",
        "name": "JavaScript",
        "extensions": [".js", ".jsx"],
        "lsp_server": "typescript-language-server",
        "features": ["syntax", "completion", "hover", "diagnostics"]
      }
    ],
    "file_operations": [
      {
        "id": "navis-file-read",
        "name": "文件读取",
        "description": "读取文件内容"
      },
      {
        "id": "navis-file-write",
        "name": "文件写入",
        "description": "写入文件内容"
      },
      {
        "id": "navis-git-status",
        "name": "Git 状态",
        "description": "获取 Git 仓库状态"
      }
    ]
  },
  "author": "navis",
  "name": "Navis Editor",
  "permissions": {
    "ipc": [],
    "events": [],
    "terminal": [],
    "network": [],
    "resources": {
      "timeout_ms": 30000,
      "max_cpu_percent": 50.0,
      "max_memory_mb": 512
    },
    "filesystem": []
  },
  "id": "navis-editor",
  "description": "编辑器扩展：文件管理、Git 操作、剪贴板、后端工具集成。"
}