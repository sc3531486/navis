{
  "version": "0.1.0",
  "contributes": {
    "capabilities": {
      "provides": [
        "navis-ai-platform",
        "gateway.engine",
        "gateway.router",
        "gateway.quota",
        "gateway.cost",
        "gateway.offline",
        "gateway.middleware",
        "gateway.protocol",
        "gateway.provider"
      ],
      "invoke": [
        "extensions.query",
        "runtime.operation.list",
        "storage.get",
        "storage.set",
        "gateway.chat",
        "gateway.stream"
      ]
    },
    "gateway.adapters": [
      {
        "id": "chat-completions",
        "protocol": "chat_completions",
        "description": "OpenAI Chat Completions 协议适配器"
      },
      {
        "id": "responses",
        "protocol": "responses",
        "description": "OpenAI Responses 协议适配器"
      }
    ],
    "gateway.providers": [],
    "middlewares": [],
    "transport_adapters": []
  },
  "author": "navis",
  "name": "Navis AI Platform",
  "permissions": {
    "ipc": [],
    "events": [],
    "terminal": [],
    "network": ["*.openai.com", "*.anthropic.com", "*.deepseek.com"],
    "resources": {
      "timeout_ms": 60000,
      "max_cpu_percent": 30.0,
      "max_memory_mb": 256
    },
    "filesystem": []
  },
  "id": "navis-ai-platform",
  "description": "AI 平台服务扩展：Gateway 统一模型网关、协议适配器、Provider 管理、Quota 计量、成本统计。"
}
