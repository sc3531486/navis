        <mxCell id="case4Panel4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DEF;strokeWidth=2;arcSize=8;fontSize=12;fontColor=#242424;align=center;verticalAlign=middle;" vertex="1" parent="1">
