        <mxCell id="contextTooltipArrow" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#DADADA;strokeWidth=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="984" y="204" as="sourcePoint" />
            <mxPoint x="984" y="227" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="extensionEntryRef" value="+ 菜单扩展点：附件、命令、连接器、扩展入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF8;strokeColor=#2E9D73;strokeWidth=1;arcSize=6;fontSize=11;fontColor=#2E6D52;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="210" y="340" width="310" height="28" as="geometry" />
        </mxCell>
        <mxCell id="statusControlsRef" value="Status controls: permission policy, model selector, context status, plan/goal running chips (blinking means executing; hover shows x to close)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF8;strokeColor=#2E9D73;strokeWidth=1;arcSize=6;fontSize=11;fontColor=#2E6D52;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="340" width="300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="contextIndicatorRef" value="上下文扩展点：圆环状态 + hover 横条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF8;strokeColor=#2E9D73;strokeWidth=1;arcSize=6;fontSize=11;fontColor=#2E6D52;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="340" width="250" height="28" as="geometry" />
        </mxCell>
        <mxCell id="barNote" value="结构约定：A 区只负责输入文本与发送，默认一行高度，输入超过一行后自动增高；运行队列和目标状态条紧贴 A 区上方，但不与输入框同宽，左右保留一段内收距离；B 区负责扩展入口、权限、Model + Effort 联合选择、上下文状态。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#8B8B8B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="90" y="430" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="contextNote" value="Context ring fills color by usage. Hovering the ring shows a horizontal detail bar above it with used percent, total context, and compression threshold." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8B8B8B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="90" y="466" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="workspaceRowRef" value="会话工作目录行（位于目标/队列下方、A 区输入框上方）：当前目录按钮和文件夹 + 都打开“最近打开过的目录”菜单；展示最近 10 个；菜单底部“选择新的工作目录”才调用系统目录选择器；选择结果写入当前 Session.worktreeRoot。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF8;strokeColor=#2E9D73;strokeWidth=1;arcSize=6;fontSize=11;fontColor=#2E6D52;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="90" y="512" width="980" height="38" as="geometry" />
        </mxCell>
        <mxCell id="sessionStartStateRef" value="startWorkspace 可复用：会话开始页引用这里的紧凑输入框、发送按钮、工作目录行和 Model + Effort 选择，但页面布局属于 navis-ui-start-workspace.drawio。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DEF;strokeWidth=1;arcSize=6;fontSize=11;fontColor=#3F5F99;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="90" y="572" width="470" height="42" as="geometry" />
        </mxCell>
        <mxCell id="taskStartStateRef" value="startWorkspace 可复用：任务开始页引用这里的 + 菜单、权限、上下文、Model + Effort 等控件，但居中任务输入卡片由开始页单独定义。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F1;strokeColor=#F26B3A;strokeWidth=1;arcSize=6;fontSize=11;fontColor=#6B4A2B;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="590" y="572" width="480" height="42" as="geometry" />
        </mxCell>
      </root>
