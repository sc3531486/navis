        <mxCell id="contextTooltip" value="Used 7.8% (78K / 1M) · Compression threshold 80%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADADA;strokeWidth=1;shadow=1;arcSize=8;fontSize=11;fontColor=#242424;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="650" y="170" width="420" height="34" as="geometry" />
