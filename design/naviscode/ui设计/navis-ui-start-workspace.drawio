<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.2.2 Chrome/134.0.6998.178 Electron/35.1.2 Safari/537.36" version="26.2.2">
  <diagram name="开始页详情" id="navis-ui-start-workspace-detail">
    <mxGraphModel dx="1202" dy="815" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="startWorkspace：创建会话 / 创建任务开始页" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#242424;" parent="1" vertex="1">
          <mxGeometry x="70" y="48" width="760" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="这是开始页 UI surface，不属于 composer.input；它复用输入、工作目录、模型选择等组件，但负责首屏布局、引导内容和开始语义。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#8B8B8B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="70" y="92" width="1040" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sessionTitle" value="创建会话开始页（New session）" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#242424;" parent="1" vertex="1">
          <mxGeometry x="70" y="155" width="320" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sessionShell" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADADA;strokeWidth=1;arcSize=6;" parent="1" vertex="1">
          <mxGeometry x="70" y="190" width="600" height="560" as="geometry" />
        </mxCell>
        <mxCell id="sessionHero" value="What’s up next?&#xa;概览 / 最近统计 / 空会话引导" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#242424;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="120" y="238" width="420" height="58" as="geometry" />
        </mxCell>
        <mxCell id="sessionStats" value="会话概览模块&#xa;接入后端统计数据后展示最近会话、消息量、Token、活跃情况" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=none;arcSize=6;fontSize=12;fontColor=#777777;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="120" y="330" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sessionWorkspaceRow" value="工作目录预选：Local 或真实目录名（如 demo）/ 最近目录 / 选择新的工作目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E5;strokeWidth=1;arcSize=6;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="120" y="622" width="490" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sessionComposer" value="底部紧凑输入框：Describe a task or ask a question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E5;strokeWidth=1;arcSize=6;fontSize=12;fontColor=#A0A0A0;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="120" y="662" width="490" height="42" as="geometry" />
        </mxCell>
        <mxCell id="sessionNote" value="提交首条消息后创建真实 Session，并通过 ui_stream_session_message 写入消息、调用 Gateway、推送 AgentSteps、刷新会话树。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8B8B8B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="120" y="712" width="490" height="28" as="geometry" />
        </mxCell>
        <mxCell id="taskTitle" value="创建任务开始页（New task）" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#242424;" parent="1" vertex="1">
          <mxGeometry x="730" y="155" width="320" height="24" as="geometry" />
        </mxCell>
        <mxCell id="taskShell" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADADA;strokeWidth=1;arcSize=6;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="730" y="190" width="600" height="560" as="geometry" />
        </mxCell>
        <mxCell id="taskHero" value="Let’s knock something off your list&#xa;Cowork 任务启动引导" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#242424;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="810" y="300" width="460" height="58" as="geometry" />
        </mxCell>
        <mxCell id="taskCard" value="大任务描述输入框&#xa;&#xa;How can I help you today?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E5;strokeWidth=1;arcSize=6;fontSize=14;fontColor=#777777;align=left;verticalAlign=top;spacing=22;" parent="1" vertex="1">
          <mxGeometry x="810" y="390" width="460" height="148" as="geometry" />
        </mxCell>
        <mxCell id="taskToolbar" value="+ 菜单    Work in a project v                                      gpt-5.5 v" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E5;strokeWidth=1;arcSize=6;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;spacing=16;" parent="1" vertex="1">
          <mxGeometry x="810" y="538" width="460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="taskNote" value="提交后创建 Cowork 任务会话；Background tasks 面板从后端 TaskManager 读取运行状态。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#8B8B8B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="810" y="605" width="460" height="28" as="geometry" />
        </mxCell>
        <mxCell id="extensionStartNote" value="模式扩展开始页：Custom 模式扩展可注册 startWorkspace:custom:&lt;runtimeId&gt; 替换开始页主体；宿主仍提供工作目录、模型、权限和发送底座。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF8;strokeColor=#2E9D73;strokeWidth=1;arcSize=6;fontSize=12;fontColor=#2E6D52;align=left;verticalAlign=middle;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="70" y="790" width="1260" height="44" as="geometry" />
        </mxCell>
      </root>
