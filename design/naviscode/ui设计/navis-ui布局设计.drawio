        <mxCell id="card1" value="&lt;b&gt;01 顶部栏&lt;/b&gt;&lt;br/&gt;全局导航、侧栏切换、搜索、后退/前进、窗口控制。&lt;br/&gt;&lt;font color='#5B8DEF'&gt;navis-ui-topbar.drawio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADADA;strokeWidth=1;shadow=0;arcSize=6;fontSize=12;fontColor=#242424;spacing=8;" vertex="1" parent="1" link="navis-ui-topbar.drawio">
          <mxGeometry x="1320" y="150" width="255" height="86" as="geometry" />
        </mxCell>
        <mxCell id="card2" value="&lt;b&gt;02 左侧栏&lt;/b&gt;&lt;br/&gt;Cowork / Code / Custom 三态；模式菜单、Group 会话、Gateway 固定按钮。&lt;br/&gt;&lt;font color='#5B8DEF'&gt;navis-ui-left-sidebar.drawio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADADA;strokeWidth=1;shadow=0;arcSize=6;fontSize=12;fontColor=#242424;spacing=8;" vertex="1" parent="1" link="navis-ui-left-sidebar.drawio">
          <mxGeometry x="1320" y="260" width="255" height="86" as="geometry" />
        </mxCell>
        <mxCell id="card3" value="&lt;b&gt;03 对话消息&lt;/b&gt;&lt;br/&gt;36px 标题栏、消息正文、Navis AgentSteps / Turn Timeline。&lt;br/&gt;&lt;font color='#5B8DEF'&gt;navis-ui-chat-messages.drawio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADADA;strokeWidth=1;shadow=0;arcSize=6;fontSize=12;fontColor=#242424;spacing=8;" vertex="1" parent="1" link="navis-ui-chat-messages.drawio">
          <mxGeometry x="1320" y="370" width="255" height="86" as="geometry" />
        </mxCell>
        <mxCell id="card4" value="&lt;b&gt;04 输入框与多功能栏&lt;/b&gt;&lt;br/&gt;A/B 区、工作目录行、+ 菜单、权限、Model + Effort、上下文状态；供会话态和开始页复用。&lt;br/&gt;&lt;font color='#5B8DEF'&gt;navis-ui-chat-input-status.drawio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADADA;strokeWidth=1;shadow=0;arcSize=6;fontSize=12;fontColor=#242424;spacing=8;" vertex="1" parent="1" link="navis-ui-chat-input-status.drawio">
          <mxGeometry x="1320" y="480" width="255" height="86" as="geometry" />
        </mxCell>
        <mxCell id="card5" value="&lt;b&gt;05 右侧面板&lt;/b&gt;&lt;br/&gt;默认关闭不占宽度；开启后按 1 / 2 / 3 / 4+ 菜单动态分列与纵向平分。&lt;br/&gt;&lt;font color='#5B8DEF'&gt;navis-ui-right-panel.drawio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADADA;strokeWidth=1;shadow=0;arcSize=6;fontSize=12;fontColor=#242424;spacing=8;" vertex="1" parent="1" link="navis-ui-right-panel.drawio">
          <mxGeometry x="1320" y="590" width="255" height="86" as="geometry" />
        </mxCell>
        <mxCell id="card6" value="&lt;b&gt;06 Gateway 菜单&lt;/b&gt;&lt;br/&gt;Gateway 按钮当前只触发 Settings、Language；Settings 使用紧凑 dialog。&lt;br/&gt;&lt;font color='#5B8DEF'&gt;navis-ui-gateway-menu.drawio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADADA;strokeWidth=1;shadow=0;arcSize=6;fontSize=12;fontColor=#242424;spacing=8;" vertex="1" parent="1" link="navis-ui-gateway-menu.drawio">
          <mxGeometry x="1320" y="700" width="255" height="86" as="geometry" />
        </mxCell>
        <mxCell id="card9" value="&lt;b&gt;07 开始页&lt;/b&gt;&lt;br/&gt;New session / New task 的独立开始页状态，复用输入组件但不属于输入区本体。&lt;br/&gt;&lt;font color='#5B8DEF'&gt;navis-ui-start-workspace.drawio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DEF;strokeWidth=1;shadow=0;arcSize=6;fontSize=12;fontColor=#242424;spacing=8;" vertex="1" parent="1" link="navis-ui-start-workspace.drawio">
